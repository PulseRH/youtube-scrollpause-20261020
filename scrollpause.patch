@@ -0,0 +1,49 @@
+package app.morphe.extension.youtube.patches;
+
+public final class SmoothZoomPanTest {
+    private static int checks;
+    private static void expect(float actual, float expected, String label) {
+        checks++;
+        if (!Float.isFinite(actual) || Math.abs(actual - expected) > .01f) {
+            throw new AssertionError(label + ": " + actual + " expected " + expected);
+        }
+    }
+    public static void main(String[] args) {
+        SmoothZoomPan pan = new SmoothZoomPan();
+        pan.drag(500, -500);
+        pan.constrain(500, 250, 1000, 500, 0, 0, 1000, 500);
+        expect(pan.x(), 0, "No horizontal panning at fit");
+        expect(pan.y(), 0, "No vertical panning at fit");
+        pan.drag(500, -500);
+        pan.constrain(500, 250, 1100, 550, 0, 0, 1000, 500);
+        expect(pan.x(), 50, "1.1x horizontal crop boundary");
+        expect(pan.y(), -25, "1.1x vertical crop boundary");
+        pan.drag(-1000, 1000);
+        pan.constrain(500, 250, 1100, 550, 0, 0, 1000, 500);
+        expect(pan.x(), -50, "Opposite horizontal boundary");
+        expect(pan.y(), 25, "Opposite vertical boundary");
+        pan.reset();
+        pan.drag(20, 15);
+        pan.constrain(500, 250, 2000, 1000, 0, 0, 1000, 500);
+        expect(pan.x(), 20, "Drag follows finger horizontally");
+        expect(pan.y(), 15, "Drag follows finger vertically");
+        // 16:9 content on a wider display: bars do not become pannable picture.
+        pan.drag(1000, 1000);
+        pan.constrain(1200, 540, 2112, 1188, 0, 0, 2400, 1080);
+        expect(pan.x(), 0, "No panning into pillarbox space");
+        expect(pan.y(), 54, "Only the genuinely cropped axis moves");
+        pan.constrain(1200, 540, 1920, 1080, 0, 0, 2400, 1080);
+        expect(pan.y(), 0, "Zooming out recentres the uncropped axis");
+        pan.reset();
+        pan.drag(Float.NaN, 10);
+        expect(pan.x(), 0, "Reject invalid touch coordinate");
+        pan.drag(10000, 10000);
+        pan.constrain(600, 350, 1400, 700, 100, 100, 1000, 500);
+        expect(pan.x(), 200, "Viewport offset horizontal boundary");
+        expect(pan.y(), 100, "Viewport offset vertical boundary");
+        pan.reset();
+        expect(pan.x(), 0, "New video resets horizontal offset");
+        expect(pan.y(), 0, "New video resets vertical offset");
+        System.out.println("PASS: " + checks + " crop/pan checks");
+    }
+}
