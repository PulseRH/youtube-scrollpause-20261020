@@ -0,0 +1,113 @@
+package app.morphe.patches.youtube.layout.player.fullscreen
+
+import app.morphe.patches.youtube.misc.gms.gmsCoreSupportPatch
+import app.morphe.patcher.extensions.InstructionExtensions.addInstructionsWithLabels
+import app.morphe.patches.scrollpause.bundle.bytecodePatch
+import app.morphe.patcher.util.proxy.mutableTypes.MutableMethod
+import app.morphe.patcher.util.proxy.mutableTypes.MutableMethod.Companion.toMutable
+import app.morphe.patches.all.misc.resources.addResourcesPatch
+import app.morphe.patches.shared.misc.settings.preference.SwitchPreference
+import app.morphe.patches.youtube.misc.settings.PreferenceScreen
+import app.morphe.patches.youtube.shared.Constants.COMPATIBILITY_YOUTUBE
+import app.morphe.patches.youtube.shared.YouTubeActivityOnCreateFingerprint
+import app.morphe.patches.youtube.video.videoid.hookVideoId
+import app.morphe.patches.youtube.video.videoid.videoIdPatch
+import app.morphe.util.addInstructionsAtControlFlowLabel
+import app.morphe.util.cloneMutable
+import app.morphe.util.setExtensionIsPatchIncluded
+import com.android.tools.smali.dexlib2.builder.MutableMethodImplementation
+import com.android.tools.smali.dexlib2.AccessFlags
+import com.android.tools.smali.dexlib2.immutable.ImmutableMethod
+import com.android.tools.smali.dexlib2.immutable.ImmutableMethodParameter
+
+private const val SMOOTH_ZOOM = "Lapp/morphe/extension/youtube/patches/SmoothZoomPatch;"
+
+@Suppress("unused")
+val smoothZoomPatch = bytecodePatch(
+    name = "Smooth pinch zoom",
+    description = "Continuous fullscreen zoom from 1x to 8x with a brief percentage display and drag-to-pan, without snap-to-fill.",
+) {
+    compatibleWith(COMPATIBILITY_YOUTUBE)
+    dependsOn(gmsCoreSupportPatch, disableFullscreenGesturesPatch, fullscreenVideoScalePatch, videoIdPatch, addResourcesPatch)
+
+    execute {
+        setExtensionIsPatchIncluded(SMOOTH_ZOOM)
+        PreferenceScreen.VIDEO.addPreferences(SwitchPreference("morphe_smooth_pinch_zoom", summary = true))
+        hookVideoId("$SMOOTH_ZOOM->onVideoChanged(Ljava/lang/String;)V")
+        YouTubePlayerViewOnLayoutFingerprint.let {
+            it.method.addInstructionsAtControlFlowLabel(
+                it.instructionMatches.first().index,
+                "invoke-static { p0 }, $SMOOTH_ZOOM->onPlayerViewLayout(Landroid/view/View;)V"
+            )
+        }
+        // These guards precede the upstream/native handlers, so there is one scale owner.
+        for (name in listOf("onScaleBegin", "onScale", "onScaleEnd")) {
+            val method = VideoZoomScaleBeginFingerprint.classDef.methods.single {
+                it.name == name && it.parameterTypes == listOf("Landroid/view/ScaleGestureDetector;")
+            }
+            val (native, wrapper) = wrapSmoothZoomCallback(method)
+            VideoZoomScaleBeginFingerprint.classDef.methods.apply {
+                remove(method)
+                add(native)
+                add(wrapper)
+            }
+        }
+        val activity = YouTubeActivityOnCreateFingerprint.classDef
+        val touch = activity.methods.firstOrNull {
+            it.name == "dispatchTouchEvent" && it.returnType == "Z" &&
+                it.parameterTypes == listOf("Landroid/view/MotionEvent;")
+        }
+        if (touch != null) {
+            val native = touch.cloneMutable(name = "scrollPauseNative_dispatchTouchEvent")
+            val wrapper = smoothZoomTouchWrapper(activity.type, touch.accessFlags,
+                "invoke-virtual { p0, p1 }, ${activity.type}->${native.name}(Landroid/view/MotionEvent;)Z")
+            activity.methods.remove(touch)
+            activity.methods.add(native)
+            activity.methods.add(wrapper)
+        } else {
+            activity.methods.add(smoothZoomTouchWrapper(activity.type, AccessFlags.PUBLIC.value,
+                "invoke-super { p0, p1 }, ${activity.superclass}->dispatchTouchEvent(Landroid/view/MotionEvent;)Z"))
+        }
+    }
+}
+
+/** Touch wrapper also owns its scratch register; no borrowing from native implementations. */
+internal fun smoothZoomTouchWrapper(owner: String, flags: Int, fallback: String): MutableMethod {
+    return ImmutableMethod(owner, "dispatchTouchEvent",
+        listOf(ImmutableMethodParameter("Landroid/view/MotionEvent;", null, null)),
+        "Z", flags, null, null, MutableMethodImplementation(3),
+    ).toMutable().apply {
+        addInstructionsWithLabels(0, """
+            invoke-static { p0, p1 }, $SMOOTH_ZOOM->onTouchEvent(Landroid/app/Activity;Landroid/view/MotionEvent;)Z
+            move-result v0
+            if-nez v0, :return_result
+            $fallback
+            move-result v0
+            :return_result
+            return v0
+        """)
+    }
+}
+
+/** Own wrapper frame: works even for onScaleEnd implementations with only p0/p1. */
+internal fun wrapSmoothZoomCallback(method: MutableMethod): Pair<MutableMethod, MutableMethod> {
+    val native = method.cloneMutable(name = "scrollPauseNative_${method.name}")
+    val wrapper = ImmutableMethod(
+        method.definingClass, method.name, method.parameters, method.returnType,
+        method.accessFlags, method.annotations, method.hiddenApiRestrictions,
+        MutableMethodImplementation(3), // v0 scratch; p0=v1, p1=v2.
+    ).toMutable()
+    val returnsVoid = method.returnType == "V"
+    val finish = if (returnsVoid) "return-void" else "move-result v0\nreturn v0"
+    wrapper.addInstructionsWithLabels(0, """
+        invoke-static { }, $SMOOTH_ZOOM->isEnabled()Z
+        move-result v0
+        if-eqz v0, :native_zoom
+        invoke-static { p1 }, $SMOOTH_ZOOM->${method.name}(Landroid/view/ScaleGestureDetector;)${method.returnType}
+        $finish
+        :native_zoom
+        invoke-virtual { p0, p1 }, ${method.definingClass}->${native.name}(Landroid/view/ScaleGestureDetector;)${method.returnType}
+        $finish
+    """)
+    return native to wrapper
+}
