@@ -0,0 +1,38 @@
+package app.morphe.extension.youtube.patches;
+
+public final class ScrollResumePolicyTest {
+    private static int checks;
+    private static void check(boolean value, String name) {
+        checks++;
+        if (!value) throw new AssertionError(name);
+    }
+    public static void main(String[] args) {
+        ScrollResumePolicy policy = new ScrollResumePolicy();
+        policy.scrolled(1000);
+        policy.paused();
+        check(!policy.consume(2000, true, true, true), "Never resume a manually paused video");
+        policy.arm(2000);
+        policy.paused();
+        check(!policy.consume(3000, false, true, true), "Default-off option cannot resume");
+        policy.scrolled(4000);
+        policy.arm(4100);
+        policy.paused();
+        check(!policy.consume(4500, true, true, true), "Wait for scrolling to stop");
+        policy.scrolled(4700);
+        check(!policy.consume(5000, true, true, true), "Fling extends idle delay");
+        check(policy.consume(5500, true, true, true), "Owned pause resumes after 800ms idle");
+        check(!policy.consume(5600, true, true, true), "Resume only once");
+        policy.arm(6000);
+        policy.paused();
+        check(!policy.consume(7000, true, false, true), "Background or player transition cancels");
+        policy.arm(8000);
+        policy.paused();
+        policy.cancel();
+        check(!policy.consume(9000, true, true, true), "Video change/manual tap cancels");
+        policy.arm(10000);
+        check(!policy.consume(11000, true, true, false), "Do not play before pause acknowledgement");
+        check(!policy.consume(13000, true, true, true), "Unacknowledged pause expires");
+        check(!policy.owned(), "No stale resume ownership after expiry");
+        System.out.println("PASS: " + checks + " scroll resume checks");
+    }
+}
