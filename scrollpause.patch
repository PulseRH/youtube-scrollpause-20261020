@@ -0,0 +1,72 @@
+package app.morphe.patches.youtube.interaction.autopause
+
+import app.morphe.patcher.extensions.InstructionExtensions.addInstruction
+import app.morphe.patcher.extensions.InstructionExtensions.addInstructions
+import app.morphe.patcher.patch.bytecodePatch
+import app.morphe.patcher.util.proxy.mutableTypes.MutableMethod.Companion.toMutable
+import app.morphe.patches.all.misc.resources.addResourcesPatch
+import app.morphe.patches.shared.misc.settings.preference.SwitchPreference
+import app.morphe.patches.youtube.misc.playertype.playerTypeHookPatch
+import app.morphe.patches.youtube.misc.settings.PreferenceScreen
+import app.morphe.patches.youtube.misc.settings.settingsPatch
+import app.morphe.patches.youtube.shared.Constants.COMPATIBILITY_YOUTUBE
+import app.morphe.patches.youtube.shared.YouTubeActivityOnCreateFingerprint
+import com.android.tools.smali.dexlib2.AccessFlags
+import com.android.tools.smali.dexlib2.builder.MutableMethodImplementation
+import com.android.tools.smali.dexlib2.immutable.ImmutableMethod
+import com.android.tools.smali.dexlib2.immutable.ImmutableMethodParameter
+
+private const val EXTENSION_CLASS =
+    "Lapp/morphe/extension/youtube/patches/AutoPausePatch;"
+
+@Suppress("unused")
+val autoPausePatch = bytecodePatch(
+    name = "Pause on scroll or minimise",
+    description = "Adds options to pause regular videos when scrolling, entering the mini-player, " +
+        "entering picture-in-picture, or sending YouTube to the background.",
+) {
+    compatibleWith(COMPATIBILITY_YOUTUBE)
+    dependsOn(settingsPatch, addResourcesPatch, playerTypeHookPatch)
+
+    execute {
+        PreferenceScreen.VIDEO.addPreferences(
+            SwitchPreference("morphe_pause_on_scroll", summary = true),
+            SwitchPreference("morphe_pause_on_minimise", summary = true),
+        )
+        // Register lifecycle callbacks here; do not create a window before Activity.onCreate.
+        YouTubeActivityOnCreateFingerprint.method.addInstruction(
+            0,
+            "invoke-static/range { p0 .. p0 }, $EXTENSION_CLASS->initialize(Landroid/app/Activity;)V",
+        )
+        // Observe gestures without replacing any touch listener or consuming events.
+        val activity = YouTubeActivityOnCreateFingerprint.classDef
+        val dispatch = activity.methods.firstOrNull {
+            it.name == "dispatchTouchEvent" && it.returnType == "Z" &&
+                it.parameterTypes == listOf("Landroid/view/MotionEvent;")
+        }
+        val touchHook = "invoke-static/range { p1 .. p1 }, $EXTENSION_CLASS->onTouchEvent(Landroid/view/MotionEvent;)V"
+        if (dispatch != null) {
+            dispatch.addInstruction(0, touchHook)
+        } else {
+            activity.methods.add(
+                ImmutableMethod(
+                    activity.type,
+                    "dispatchTouchEvent",
+                    listOf(ImmutableMethodParameter("Landroid/view/MotionEvent;", null, null)),
+                    "Z",
+                    AccessFlags.PUBLIC.value,
+                    null,
+                    null,
+                    MutableMethodImplementation(3),
+                ).toMutable().apply {
+                    addInstructions(0, """
+                        $touchHook
+                        invoke-super { p0, p1 }, ${activity.superclass}->dispatchTouchEvent(Landroid/view/MotionEvent;)Z
+                        move-result v0
+                        return v0
+                    """)
+                }
+            )
+        }
+    }
+}
