+package app.morphe.extension.youtube.patches;
+
+public final class ScrollPauseGestureTest {
+    private static int checks;
+    private static void check(boolean value, String description) {
+        checks++;
+        if (!value) throw new AssertionError(description);
+    }
+    public static void main(String[] args) {
+        ScrollPauseGesture gesture = new ScrollPauseGesture();
+        gesture.begin(1000);
+        gesture.move(1020);
+        gesture.scroll(1030);
+        int token = gesture.revision();
+        check(!gesture.ready(1040, token), "Do not pause while finger is still maximising player");
+        gesture.release();
+        check(gesture.ready(1300, token), "A released real list scroll still pauses");
+
+        gesture.begin(2000);
+        gesture.move(2020);
+        gesture.scroll(2030);
+        gesture.release();
+        token = gesture.revision();
+        gesture.block(2100);
+        check(!gesture.ready(2300, token), "Delayed player-size change cancels queued scroll pause");
+        gesture.move(2310);
+        gesture.scroll(2320);
+        check(!gesture.ready(2330, gesture.revision()), "Further MOVE cannot re-arm the resize gesture");
+
+        gesture.begin(2500);
+        gesture.move(2510);
+        gesture.scroll(2520);
+        gesture.release();
+        check(gesture.ready(2780, gesture.revision()), "Next normal scroll works after transition settles");
+        gesture.block(2800);
+        gesture.begin(2900);
+        gesture.move(2910);
+        gesture.scroll(2920);
+        gesture.release();
+        check(!gesture.ready(3200, gesture.revision()), "Animation-tail touches stay excluded");
+
+        gesture.begin(4000);
+        gesture.move(4010);
+        gesture.scroll(4020);
+        gesture.block(4030);
+        gesture.release();
+        check(!gesture.ready(4300, gesture.revision()), "Pinching and cancelled touches do not pause");
+
+        gesture.begin(5000);
+        gesture.scroll(5010);
+        gesture.release();
+        check(!gesture.ready(5300, gesture.revision()), "Tap plus layout scroll is not a user scroll");
+        gesture.begin(6000);
+        gesture.move(6010);
+        gesture.release();
+        check(!gesture.ready(6300, gesture.revision()), "Swipe without actual view scrolling does not pause");
+        gesture.scroll(6400);
+        check(gesture.ready(6500, gesture.revision()), "Actual fling scrolling after release is included");
+        check(!gesture.ready(8000, gesture.revision()), "Expired gesture cannot pause later playback");
+
+        gesture.begin(9000);
+        gesture.move(9020);
+        gesture.scroll(9030, true);
+        token = gesture.revision();
+        check(gesture.ready(9040, token), "Confirmed list pauses while finger is still held down");
+        check(gesture.confirmedList(), "List confirmation selects immediate path");
+        gesture.move(9060);
+        gesture.scroll(9070, true);
+        check(gesture.ready(9080, token), "Continued held scrolling remains eligible");
+        gesture.block(9100);
+        check(!gesture.ready(9110, token), "Player resize cancels even a confirmed list gesture");
+        gesture.move(9120);
+        gesture.scroll(9130, true);
+        check(!gesture.ready(9140, gesture.revision()), "Parent interception cannot re-arm immediate pause");
+        check(!gesture.confirmedList(), "Resize clears list confirmation");
+
+        gesture.begin(10000);
+        gesture.scroll(10020, true);
+        check(!gesture.ready(10030, gesture.revision()), "List tap plus layout movement does not pause");
+        gesture.move(10040);
+        check(!gesture.ready(10050, gesture.revision()), "Movement alone still needs an actual scroll notification");
+        gesture.scroll(10060, true);
+        check(gesture.ready(10070, gesture.revision()), "Next real list scroll regains immediate pause");
+        gesture.release();
+        check(gesture.ready(10100, gesture.revision()), "Confirmed list fling remains supported");
+        System.out.println("PASS: " + checks + " scroll/resize regression checks");
+    }
+}
