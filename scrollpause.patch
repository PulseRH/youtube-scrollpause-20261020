+import app.morphe.patcher.patch.rawResourcePatch as upstreamRawResourcePatch
+
+// Unnamed dependencies are executable helpers, not selectable source entries.
+private fun visibleName(name: String?) = name?.takeIf {
+    it == "Pause on scroll or minimise" || it == "Smooth pinch zoom"
+}
+fun bytecodePatch(name: String? = null, description: String? = null, default: Boolean = true,
+    block: BytecodePatchBuilder.() -> Unit = {}) =
+    upstreamBytecodePatch(visibleName(name), description, default, block)
+fun resourcePatch(name: String? = null, description: String? = null, default: Boolean = true,
+    block: ResourcePatchBuilder.() -> Unit = {}) =
+    upstreamResourcePatch(visibleName(name), description, default, block)
+fun rawResourcePatch(name: String? = null, description: String? = null, default: Boolean = true,
+    block: RawResourcePatchBuilder.() -> Unit = {}) =
+    upstreamRawResourcePatch(visibleName(name), description, default, block)
