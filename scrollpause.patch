+++ b/patches/src/test/kotlin/app/morphe/patches/youtube/layout/player/fullscreen/SmoothZoomCallbackTest.kt
@@ -0,0 +1,42 @@
+package app.morphe.patches.youtube.layout.player.fullscreen
+
+import app.morphe.patcher.extensions.InstructionExtensions.addInstructions
+import app.morphe.patcher.util.proxy.mutableTypes.MutableMethod.Companion.toMutable
+import com.android.tools.smali.dexlib2.AccessFlags
+import com.android.tools.smali.dexlib2.builder.MutableMethodImplementation
+import com.android.tools.smali.dexlib2.iface.instruction.FiveRegisterInstruction
+import com.android.tools.smali.dexlib2.iface.instruction.ReferenceInstruction
+import com.android.tools.smali.dexlib2.iface.reference.MethodReference
+import com.android.tools.smali.dexlib2.immutable.ImmutableMethod
+import com.android.tools.smali.dexlib2.immutable.ImmutableMethodParameter
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+
+class SmoothZoomCallbackTest {
+    @Test fun `two register void callback needs no free register`() = verify("onScaleEnd", "V", 2)
+    @Test fun `boolean scale callback keeps native fallback`() = verify("onScale", "Z", 3)
+    @Test fun `begin callback keeps native fallback`() = verify("onScaleBegin", "Z", 3)
+
+    private fun verify(name: String, returnType: String, registers: Int) {
+        val original = ImmutableMethod(
+            "Ltest/Zoom;", name,
+            listOf(ImmutableMethodParameter("Landroid/view/ScaleGestureDetector;", null, null)),
+            returnType, AccessFlags.PUBLIC.value or AccessFlags.FINAL.value, null, null,
+            MutableMethodImplementation(registers),
+        ).toMutable().apply {
+            addInstructions(0, if (returnType == "V") "return-void" else "const/4 v0, 0x1\nreturn v0")
+        }
+        val (native, wrapper) = wrapSmoothZoomCallback(original)
+        assertEquals(registers, native.implementation!!.registerCount)
+        assertEquals(3, wrapper.implementation!!.registerCount)
+        assertEquals(name, wrapper.name)
+        assertEquals(original.implementation!!.instructions.map { it.opcode }, native.implementation!!.instructions.map { it.opcode })
+        val fallback = wrapper.implementation!!.instructions.filterIsInstance<ReferenceInstruction>().single {
+            (it.reference as? MethodReference)?.name == native.name
+        } as FiveRegisterInstruction
+        assertEquals(1, fallback.registerC, "p0 must survive the enable check")
+        assertEquals(2, fallback.registerD, "p1 must survive the enable check")
+        assertTrue(native.name != wrapper.name)
+    }
+}
