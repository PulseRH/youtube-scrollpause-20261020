@@ -0,0 +1,21 @@
+package app.morphe.extension.youtube.patches;
+
+/** Only owns pauses explicitly issued by scroll-to-pause, never pre-existing pauses. */
+final class ScrollResumePolicy {
+    private boolean owned, acknowledged;
+    private long lastScroll, armedAt;
+
+    void scrolled(long now) { lastScroll = now; }
+    void arm(long now) { owned = true; acknowledged = false; armedAt = now; }
+    void paused() { if (owned) acknowledged = true; }
+    void cancel() { owned = acknowledged = false; }
+    boolean owned() { return owned; }
+    long delay(long now) { return acknowledged ? Math.max(1, 800 - (now - lastScroll)) : 100; }
+
+    boolean consume(long now, boolean enabled, boolean eligible, boolean paused) {
+        if (!enabled || !eligible || (!acknowledged && now - armedAt > 2000)) cancel();
+        if (!owned || !acknowledged || !paused || now - lastScroll < 800) return false;
+        cancel();
+        return true;
+    }
+}
