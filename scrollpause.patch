+// Compact only after jar assembly. Verify from the actual archive with main output
+// excluded, so missing transitive classes cannot be masked by the source tree.
+val compactCustomBundle = tasks.register<Exec>("compactCustomBundle") {
+    dependsOn(tasks.named("jar"))
+    val archive = tasks.named<Jar>("jar").flatMap { it.archiveFile }
+    doFirst {
+        commandLine("python3", rootProject.file("custom-tests/compact_bundle.py"), archive.get().asFile)
+    }
+}
+val verifyCustomBundle = tasks.register<JavaExec>("verifyCustomBundle") {
+    dependsOn(compactCustomBundle, tasks.named("testClasses"))
+    val archive = tasks.named<Jar>("jar").flatMap { it.archiveFile }
+    classpath = (sourceSets["test"].runtimeClasspath - sourceSets["main"].output) +
+        configurations["compileClasspath"] + files(archive)
+    mainClass.set("app.morphe.patches.scrollpause.bundle.VerifyCustomBundleKt")
+    doFirst { setArgs(listOf(archive.get().asFile.absolutePath)) }
+}
+tasks.named("buildAndroid") { dependsOn(verifyCustomBundle) }
