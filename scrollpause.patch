@@ -0,0 +1,34 @@
+package app.morphe.extension.youtube.patches;
+
+public final class AutoPausePolicyTest {
+    private static int checks;
+    private static void check(boolean condition, String message) {
+        checks++;
+        if (!condition) throw new AssertionError(message);
+    }
+
+    public static void main(String[] args) {
+        AutoPausePolicy policy = new AutoPausePolicy();
+        check(policy.request(1000, true), "Playing video pauses on first scroll");
+        check(!policy.request(1020, true), "Fling events do not flood media commands");
+        check(policy.request(1600, true), "A later independent scroll can pause again");
+        check(!policy.onPlaying(1700, true, true), "Manual resume after a pause stays playing");
+
+        policy = new AutoPausePolicy();
+        check(!policy.request(1000, false), "Buffering does not send an ineffective immediate pause");
+        check(policy.onPlaying(1100, true, true), "Buffering finishes shortly after minimising: pause");
+        check(!policy.onPlaying(1200, true, true), "Pending request is consumed once");
+
+        policy = new AutoPausePolicy();
+        policy.request(1000, false);
+        check(!policy.onPlaying(3000, true, true), "Expired requests cannot pause an unrelated later video");
+        policy.request(4000, false);
+        check(!policy.onPlaying(4100, false, true), "Turning off the setting cancels a pending pause");
+        policy.request(5000, false);
+        check(!policy.onPlaying(5100, true, false), "Switching to Shorts cannot use a regular-video pause");
+        policy.request(6000, false);
+        policy.cancel();
+        check(!policy.onPlaying(6100, true, true), "Returning to the player cancels a pending minimise pause");
+        System.out.println("PASS: " + checks + " pause-policy checks");
+    }
+}
