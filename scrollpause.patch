@@ -0,0 +1,31 @@
+package app.morphe.extension.youtube.patches;
+
+public final class SmoothZoomScaleTest {
+    private static int checks;
+    private static void expect(float actual, float expected, String name) {
+        checks++;
+        if (Math.abs(actual - expected) > 0.0001f || !Float.isFinite(actual)) {
+            throw new AssertionError(name + ": " + actual + " expected " + expected);
+        }
+    }
+    public static void main(String[] args) {
+        SmoothZoomScale zoom = new SmoothZoomScale();
+        expect(zoom.get(), 1f, "Starts fitted");
+        expect(zoom.update(1.1f), 1.1f, "First outward pinch is 1.1, not screen fill");
+        expect(zoom.update(1.2f / 1.1f), 1.2f, "Continues to 1.2");
+        expect(zoom.update(1f), 1.2f, "Neutral event and gesture release preserve factor");
+        expect(zoom.update(1.1f / 1.2f), 1.1f, "Reverse pinch returns smoothly to 1.1");
+        expect(zoom.update(0.1f), 1f, "Cannot zoom below fit");
+        expect(zoom.update(Float.NaN), 1f, "Ignore NaN");
+        expect(zoom.update(Float.POSITIVE_INFINITY), 1f, "Ignore infinite factor");
+        expect(zoom.update(0f), 1f, "Ignore zero factor");
+        expect(zoom.update(-1f), 1f, "Ignore negative factor");
+        expect(zoom.update(100f), 8f, "Upper safety limit");
+        expect(zoom.update(0.5f), 4f, "Can immediately zoom back from maximum");
+        zoom.reset();
+        expect(zoom.get(), 1f, "New video/fullscreen exit resets zoom");
+        for (int i = 0; i < 10; i++) zoom.update((float) Math.pow(1.1, 0.1));
+        expect(zoom.get(), 1.1f, "Small movement events accumulate without a fill threshold");
+        System.out.println("PASS: " + checks + " smooth zoom checks");
+    }
+}
diff --git a/custom-tests/compact_bundle.py b/custom-tests/compact_bundle.py
new file mode 100644
index 0000000..f7b0526
--- /dev/null
+++ b/custom-tests/compact_bundle.py
@@ -0,0 +1,68 @@
+"""Conservatively retain complete JVM classes reachable from the two custom roots.
+No method-level shrinking; reflection class-name strings and descriptors count as edges.
+Resources stay intact except payloads for the unsupported Music and Reddit apps.
+"""
+from pathlib import Path
+import re
+import struct
+import sys
+import zipfile
+
+ROOTS = {
+ 'app/morphe/patches/youtube/interaction/autopause/AutoPausePatchKt',
+ 'app/morphe/patches/youtube/layout/player/fullscreen/SmoothZoomPatchKt',
+}
+
+def references(data):
+    assert data[:4] == b'\xca\xfe\xba\xbe'
+    count = struct.unpack_from('>H', data, 8)[0]
+    offset, index = 10, 1
+    strings = []
+    while index < count:
+        tag = data[offset]; offset += 1
+        if tag == 1:
+            length = struct.unpack_from('>H', data, offset)[0]; offset += 2
+            strings.append(data[offset:offset+length].decode('utf-8', errors='replace'))
+            offset += length
+        elif tag in (3, 4, 9, 10, 11, 12, 17, 18): offset += 4
+        elif tag in (5, 6): offset += 8; index += 1
+        elif tag in (7, 8, 16, 19, 20): offset += 2
+        elif tag == 15: offset += 3
+        else: raise ValueError(f'Unknown constant pool tag {tag}')
+        index += 1
+    result = set()
+    for value in strings:
+        result.add(value)
+        result.add(value.replace('.', '/'))
+        result.update(re.findall(r'L([\w/$]+)', value))
+    return result
+
+bundle = Path(sys.argv[1])
+with zipfile.ZipFile(bundle) as z:
+    contents = {entry.filename: (entry, z.read(entry)) for entry in z.infolist()}
+classes = {name[:-6]: data for name, (_, data) in contents.items()
+           if name.endswith('.class') and not name.startswith('META-INF/versions/')}
+assert ROOTS <= classes.keys()
+# Retain dependency-library classes as-is, including their reflective entrypoints.
+keep = {name for name in classes if not name.startswith('app/morphe/patches/')}
+pending = list(keep | ROOTS)
+visited = set()
+while pending:
+    name = pending.pop()
+    if name in visited: continue
+    visited.add(name)
+    pending.extend((references(classes[name]) & classes.keys()) - visited)
+keep = visited
+removed = []
+temporary = bundle.with_suffix('.compact.tmp')
+with zipfile.ZipFile(temporary, 'w', zipfile.ZIP_DEFLATED) as z:
+    for name, (entry, data) in contents.items():
+        if (name.endswith('.class') and name[:-6] not in keep) or name in {
+            'extensions/music.mpe', 'extensions/reddit.mpe'
+        }:
+            removed.append(name)
+        else: z.writestr(entry, data)
+old_size = bundle.stat().st_size
+temporary.replace(bundle)
+print(f'Custom bundle: retained {len(keep)} JVM classes; removed {len(removed)} entries; '
+      f'{old_size:,} -> {bundle.stat().st_size:,} bytes before Android dexing')
diff --git a/extensions/youtube/src/main/java/app/morphe/extension/youtube/patches/AutoPausePatch.java b/extensions/youtube/src/main/java/app/morphe/extension/youtube/patches/AutoPausePatch.java
new file mode 100644
index 0000000..efe9e9b
--- /dev/null
+++ b/extensions/youtube/src/main/java/app/morphe/extension/youtube/patches/AutoPausePatch.java
@@ -0,0 +1,340 @@
+package app.morphe.extension.youtube.patches;
+
+import android.app.Activity;
+import android.app.Application;
+import android.content.Context;
+import android.media.AudioManager;
+import android.media.session.MediaController;
+import android.os.Bundle;
+import android.os.SystemClock;
+import android.view.KeyEvent;
+import android.view.MotionEvent;
+import android.view.View;
+import android.view.ViewConfiguration;
+import android.view.ViewTreeObserver;
+
+import java.lang.ref.WeakReference;
+import java.util.Objects;
+
+import app.morphe.extension.shared.Logger;
+import app.morphe.extension.shared.Utils;
+import app.morphe.extension.youtube.settings.Settings;
+import app.morphe.extension.youtube.shared.PlayerType;
+import app.morphe.extension.youtube.shared.ShortsPlayerState;
+import app.morphe.extension.youtube.shared.VideoState;
+import kotlin.Unit;
+
+/** Custom addition, 2026-10-20. See the upstream LICENSE and NOTICE. */
+@SuppressWarnings("unused")
+public final class AutoPausePatch {
+    private static final AutoPausePolicy scrollPolicy = new AutoPausePolicy();
+    private static final AutoPausePolicy minimisePolicy = new AutoPausePolicy();
+    private static WeakReference<Activity> activityRef = new WeakReference<>(null);
+    private static WeakReference<View> rootRef = new WeakReference<>(null);
+    private static boolean registered;
+    private static boolean started;
+    private static float downX, downY;
+    private static int touchSlop;
+    private static boolean touching;
+    private static final ScrollPauseGesture scrollGesture = new ScrollPauseGesture();
+    private static int scheduledScrollRevision = -1;
+    private static final ScrollResumePolicy resumePolicy = new ScrollResumePolicy();
+    private static boolean resumeCheckScheduled;
+    private static boolean touchMoved;
+    private static String videoId;
+    private static WeakReference<View> touchedListRef = new WeakReference<>(null);
+
+    /** A player pan must not leave a half-observed scroll/resume gesture armed. */
+    public static void onPlayerPan() {
+        if (!registered) return;
+        touching = false;
+        touchedListRef.clear();
+        scrollGesture.block(SystemClock.uptimeMillis());
+        scrollPolicy.cancel();
+        resumePolicy.cancel();
+    }
+
+    /** Injection point. Observes a gesture; never consumes or changes a touch event. */
+    public static void onTouchEvent(MotionEvent event) {
+        if (event == null) return;
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                touchedListRef.clear();
+                downX = event.getX();
+                downY = event.getY();
+                touching = true;
+                touchMoved = false;
+                scrollGesture.begin(SystemClock.uptimeMillis());
+                scrollPolicy.cancel();
+                break;
+            case MotionEvent.ACTION_MOVE:
+                if (touching && (Math.abs(event.getX() - downX) > touchSlop
+                        || Math.abs(event.getY() - downY) > touchSlop)) {
+                    scrollGesture.move(SystemClock.uptimeMillis());
+                    touchMoved = true;
+                }
+                break;
+            case MotionEvent.ACTION_CANCEL:
+            case MotionEvent.ACTION_POINTER_DOWN:
+                touching = false;
+                touchedListRef.clear();
+                scrollGesture.block(SystemClock.uptimeMillis());
+                scrollPolicy.cancel();
+                resumePolicy.cancel();
+                break;
+            case MotionEvent.ACTION_UP:
+                touching = false;
+                if (!touchMoved) resumePolicy.cancel(); // A control tap is manual intent.
+                scrollGesture.release();
+                scheduleScrollPause();
+                break;
+        }
+    }
+
+    /** Hooked in RecyclerView.onTouchEvent, not the outer player drag container. */
+    public static void onListTouch(View list, MotionEvent event) {
+        if (!registered || list == null || event == null) return;
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+            case MotionEvent.ACTION_MOVE:
+                if (touching && event.getPointerCount() == 1) {
+                    touchedListRef = new WeakReference<>(list);
+                }
+                break;
+            case MotionEvent.ACTION_CANCEL:
+                if (touchedListRef.get() == list) {
+                    // A parent took over (for example to expand the player).
+                    touchedListRef.clear();
+                    scrollGesture.block(SystemClock.uptimeMillis());
+                    scrollPolicy.cancel();
+                    resumePolicy.cancel();
+                }
+                break;
+            case MotionEvent.ACTION_POINTER_DOWN:
+                touchedListRef.clear();
+                break;
+            // Keep the source through ACTION_UP for genuine list flings.
+        }
+    }
+
+    private static boolean regularVideo() {
+        PlayerType type = PlayerType.getCurrent();
+        return !ShortsPlayerState.isOpen() && !type.isNoneOrHidden()
+                && type != PlayerType.INLINE_MINIMAL;
+    }
+
+    private static void requestPause(AutoPausePolicy policy) {
+        // A paused video must stay paused; do not arm a pending pause on an already paused video.
+        if (!regularVideo() || VideoState.getCurrent() == VideoState.PAUSED
+                || VideoState.getCurrent() == VideoState.ENDED) return;
+        if (policy.request(SystemClock.uptimeMillis(), VideoState.getCurrent() == VideoState.PLAYING)) {
+            issuePause(policy);
+        }
+    }
+
+    private static void issuePause(AutoPausePolicy policy) {
+        boolean resume = policy == scrollPolicy && Settings.RESUME_AFTER_SCROLL.get();
+        if (resume) resumePolicy.arm(SystemClock.uptimeMillis());
+        if (!sendMediaCommand(true) && resume) resumePolicy.cancel();
+        if (resume) scheduleResume();
+    }
+
+    private static boolean sendMediaCommand(boolean pause) {
+        try {
+            Activity activity = activityRef.get();
+            if (activity == null) return false;
+            MediaController controller = activity.getMediaController();
+            if (controller != null) {
+                // Prefer an explicitly associated session, so another app cannot receive the command.
+                if (pause) controller.getTransportControls().pause();
+                else controller.getTransportControls().play();
+                return true;
+            }
+            // Same pause-only media command used by upstream's pause-on-screen-lock feature.
+            AudioManager audio = (AudioManager) activity.getSystemService(Context.AUDIO_SERVICE);
+            if (audio == null || (pause && !audio.isMusicActive()) || (!pause && audio.isMusicActive())) return false;
+            long now = SystemClock.uptimeMillis();
+            int key = pause ? KeyEvent.KEYCODE_MEDIA_PAUSE : KeyEvent.KEYCODE_MEDIA_PLAY;
+            audio.dispatchMediaKeyEvent(new KeyEvent(now, now, KeyEvent.ACTION_DOWN, key, 0));
+            audio.dispatchMediaKeyEvent(new KeyEvent(now, now, KeyEvent.ACTION_UP, key, 0));
+            return true;
+        } catch (Exception ex) {
+            Logger.printException(() -> "Auto-pause/resume failed", ex);
+            return false;
+        }
+    }
+
+    private static void scheduleResume() {
+        if (resumeCheckScheduled || !resumePolicy.owned()) return;
+        resumeCheckScheduled = true;
+        Utils.runOnMainThreadDelayed(() -> {
+            resumeCheckScheduled = false;
+            Activity activity = activityRef.get();
+            boolean eligible = started && activity != null && activity.hasWindowFocus()
+                    && regularVideo() && stablePlayer() && Settings.PAUSE_ON_SCROLL.get();
+            if (touching && eligible && Settings.RESUME_AFTER_SCROLL.get()) {
+                scheduleResume();
+                return;
+            }
+            if (resumePolicy.consume(SystemClock.uptimeMillis(), Settings.RESUME_AFTER_SCROLL.get(),
+                    eligible, VideoState.getCurrent() == VideoState.PAUSED)) {
+                sendMediaCommand(false);
+            }
+            scheduleResume();
+        }, touching ? 100 : resumePolicy.delay(SystemClock.uptimeMillis()));
+    }
+
+    public static void onVideoChanged(String id) {
+        Utils.runOnMainThreadNowOrLater(() -> {
+            if (!Objects.equals(videoId, id)) {
+                videoId = id;
+                resumePolicy.cancel();
+                touchedListRef.clear();
+                scrollGesture.block(SystemClock.uptimeMillis());
+                scrollPolicy.cancel();
+            }
+        });
+    }
+
+    private static final ViewTreeObserver.OnScrollChangedListener SCROLL_LISTENER = () -> {
+        resumePolicy.scrolled(SystemClock.uptimeMillis());
+        View list = touchedListRef.get();
+        scrollGesture.scroll(SystemClock.uptimeMillis(), list != null && list.isAttachedToWindow());
+        scheduleScrollPause();
+    };
+
+    private static boolean stablePlayer() {
+        PlayerType type = PlayerType.getCurrent();
+        return type == PlayerType.WATCH_WHILE_MAXIMIZED
+                || type == PlayerType.WATCH_WHILE_FULLSCREEN
+                || type == PlayerType.WATCH_WHILE_MINIMIZED;
+    }
+
+    private static void scheduleScrollPause() {
+        int revision = scrollGesture.revision();
+        if (scrollGesture.confirmedList()) {
+            // A real list received this drag and a scroll was reported. Do not
+            // wait for finger release or the player-resize grace period.
+            pauseScrollIfEligible(revision);
+            return;
+        }
+        if (scheduledScrollRevision == revision || !scrollGesture.ready(SystemClock.uptimeMillis(), revision)) return;
+        scheduledScrollRevision = revision;
+        // Wait for release and for the player transition to become visible. Resizing the
+        // player can emit scroll notifications before its PlayerType changes.
+        Utils.runOnMainThreadDelayed(() -> {
+            if (scheduledScrollRevision == revision) scheduledScrollRevision = -1;
+            pauseScrollIfEligible(revision);
+        }, 250);
+    }
+
+    private static void pauseScrollIfEligible(int revision) {
+        Activity activity = activityRef.get();
+        if (scrollGesture.ready(SystemClock.uptimeMillis(), revision)
+                && started && activity != null && activity.hasWindowFocus()
+                && stablePlayer() && Settings.PAUSE_ON_SCROLL.get()) {
+            requestPause(scrollPolicy);
+        }
+    }
+
+    private static void detachScrollListener() {
+        View root = rootRef.get();
+        if (root != null && root.getViewTreeObserver().isAlive()) {
+            root.getViewTreeObserver().removeOnScrollChangedListener(SCROLL_LISTENER);
+        }
+        rootRef.clear();
+    }
+
+    private static final Application.ActivityLifecycleCallbacks CALLBACKS =
+            new Application.ActivityLifecycleCallbacks() {
+        @Override public void onActivityStarted(Activity activity) {
+            if (activityRef.get() != activity) return;
+            started = true;
+            minimisePolicy.cancel();
+            detachScrollListener();
+            View root = activity.getWindow().getDecorView();
+            rootRef = new WeakReference<>(root);
+            root.getViewTreeObserver().addOnScrollChangedListener(SCROLL_LISTENER);
+        }
+
+        @Override public void onActivityStopped(Activity activity) {
+            if (activityRef.get() != activity) return;
+            started = false;
+            touchedListRef.clear();
+            resumePolicy.cancel();
+            scrollGesture.block(SystemClock.uptimeMillis());
+            detachScrollListener();
+            scrollPolicy.cancel();
+            // Exclude configuration changes such as rotating the phone.
+            if (!activity.isChangingConfigurations() && Settings.PAUSE_ON_MINIMISE.get()) {
+                requestPause(minimisePolicy);
+            }
+        }
+
+        @Override public void onActivityDestroyed(Activity activity) {
+            if (activityRef.get() != activity) return;
+            started = false;
+            touchedListRef.clear();
+            resumePolicy.cancel();
+            scrollGesture.block(SystemClock.uptimeMillis());
+            detachScrollListener();
+            scrollPolicy.cancel();
+            minimisePolicy.cancel();
+            activityRef.clear();
+        }
+
+        @Override public void onActivityCreated(Activity a, Bundle b) {}
+        @Override public void onActivityResumed(Activity a) {}
+        @Override public void onActivityPaused(Activity a) {}
+        @Override public void onActivitySaveInstanceState(Activity a, Bundle b) {}
+    };
+
+    /** Injection point. Runs before the main activity's onCreate body. */
+    public static void initialize(Activity activity) {
+        activityRef = new WeakReference<>(activity);
+        touchSlop = ViewConfiguration.get(activity).getScaledTouchSlop();
+        if (registered) return;
+        registered = true;
+        activity.getApplication().registerActivityLifecycleCallbacks(CALLBACKS);
+
+        PlayerType.getOnChange().addObserver(type -> {
+            Utils.runOnMainThreadNowOrLater(() -> {
+                // A swipe to expand/fullscreen is a player gesture, not list scrolling.
+                // Block the whole gesture so later MOVE events cannot re-arm it.
+                scrollGesture.block(SystemClock.uptimeMillis());
+                touchedListRef.clear();
+                scrollPolicy.cancel();
+                resumePolicy.cancel();
+                if (Settings.PAUSE_ON_MINIMISE.get()
+                        && (type == PlayerType.WATCH_WHILE_MINIMIZED
+                        || type == PlayerType.WATCH_WHILE_PICTURE_IN_PICTURE)) {
+                    requestPause(minimisePolicy);
+                } else {
+                    minimisePolicy.cancel();
+                }
+            });
+            return Unit.INSTANCE;
+        });
+
+        VideoState.getOnChange().addObserver(state -> {
+            Utils.runOnMainThreadNowOrLater(() -> {
+                if (state == VideoState.PAUSED) {
+                    resumePolicy.paused();
+                    scheduleResume();
+                } else if (state != VideoState.PLAYING || resumePolicy.owned()) {
+                    resumePolicy.cancel();
+                }
+                if (state != VideoState.PLAYING) return;
+                long now = SystemClock.uptimeMillis();
+                if (scrollPolicy.onPlaying(now, Settings.PAUSE_ON_SCROLL.get(), started && regularVideo()
+                        && stablePlayer() && scrollGesture.ready(now, scrollGesture.revision()))) {
+                    issuePause(scrollPolicy);
+                }
+                if (minimisePolicy.onPlaying(now, Settings.PAUSE_ON_MINIMISE.get(), regularVideo())) {
+                    issuePause(minimisePolicy);
+                }
+            });
+            return Unit.INSTANCE;
+        });
+    }
+}
