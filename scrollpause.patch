+package app.morphe.patches.scrollpause.bundle
+
+import app.morphe.patcher.patch.Patch
+import app.morphe.patcher.patch.loadPatchesFromJar
+import java.io.File
+import java.util.zip.ZipFile
+
+/** Runs with the compacted archive, never the unpruned main classes. */
+fun main(args: Array<String>) {
+    val archive = File(args.single())
+    val patches = loadPatchesFromJar(setOf(archive))
+    check(patches.map { it.name }.toSet() == setOf("Pause on scroll or minimise", "Smooth pinch zoom")) {
+        "Unexpected selectable patches: ${patches.map { it.name }}"
+    }
+    val visited = mutableSetOf<Patch<*>>()
+    fun visit(patch: Patch<*>) {
+        if (!visited.add(patch)) return
+        patch.dependencies.forEach(::visit)
+    }
+    patches.forEach(::visit)
+    check(visited.size > 2) { "Required dependencies missing" }
+    check(visited.filter { it !in patches }.all { it.name == null })
+    ZipFile(archive).use { zip ->
+        check(zip.getEntry("extensions/youtube.mpe") != null)
+        check(zip.getEntry("extensions/shared-youtube.mpe") != null)
+        check(zip.getEntry("extensions/music.mpe") == null)
+        check(zip.getEntry("extensions/reddit.mpe") == null)
+    }
+    println("Verified exactly two selectable patches and ${visited.size - 2} hidden dependency objects")
+}
