+package app.morphe.extension.youtube.patches;
+
+/** Main-thread-only, Android-independent pause request policy. Never requests play. */
+final class AutoPausePolicy {
+    private long pendingUntil;
+    private long lastPause = -500;
+
+    boolean request(long now, boolean playing) {
+        if (!playing) {
+            // A transition can arrive just before the PLAYING notification while buffering.
+            pendingUntil = now + 1500;
+            return false;
+        }
+        pendingUntil = 0;
+        if (now - lastPause < 500) return false;
+        lastPause = now;
+        return true;
+    }
+
+    boolean onPlaying(long now, boolean enabled, boolean eligible) {
+        boolean pending = pendingUntil > now;
+        pendingUntil = 0;
+        return pending && enabled && eligible && request(now, true);
+    }
+
+    void cancel() {
+        pendingUntil = 0;
+    }
+}
