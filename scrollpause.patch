@@ -0,0 +1,52 @@
+package app.morphe.extension.youtube.patches;
+
+/** Scroll intent survives a fling, but never a player-size transition or a pinch. */
+final class ScrollPauseGesture {
+    private boolean blocked = true, moved, scrolled, released, confirmedList;
+    private long until, settleUntil;
+    private int revision;
+
+    void begin(long now) {
+        revision++;
+        blocked = now < settleUntil;
+        moved = scrolled = released = confirmedList = false;
+        until = 0;
+    }
+
+    void move(long now) {
+        if (blocked) return;
+        moved = true;
+        until = now + 1500;
+    }
+
+    void scroll(long now) {
+        scroll(now, false);
+    }
+
+    void scroll(long now, boolean listSource) {
+        if (!blocked && moved && now < until) {
+            scrolled = true;
+            confirmedList |= listSource;
+        }
+    }
+
+    boolean confirmedList() { return confirmedList; }
+
+    void release() { released = true; }
+
+    void block(long now) {
+        revision++;
+        blocked = true;
+        scrolled = false;
+        confirmedList = false;
+        until = 0;
+        settleUntil = now + 300;
+    }
+
+    int revision() { return revision; }
+
+    boolean ready(long now, int expectedRevision) {
+        return revision == expectedRevision && !blocked && moved && scrolled && (released || confirmedList)
+                && now >= settleUntil && now < until;
+    }
+}
