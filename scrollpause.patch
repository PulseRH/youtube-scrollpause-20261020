@@ -0,0 +1,26 @@
+package app.morphe.extension.youtube.patches;
+
+/** Screen-pixel offsets, constrained by the cropped video content, not its black bars. */
+final class SmoothZoomPan {
+    private float x, y;
+    private boolean cropped;
+    float x() { return x; }
+    float y() { return y; }
+    boolean cropped() { return cropped; }
+    void reset() { x = y = 0; cropped = false; }
+    void drag(float dx, float dy) {
+        if (Float.isFinite(dx) && Float.isFinite(dy)) { x += dx; y += dy; }
+    }
+    void constrain(float centerX, float centerY, float contentW, float contentH,
+                   float left, float top, float width, float height) {
+        cropped = contentW > width || contentH > height;
+        x = constrainAxis(x, centerX, contentW, left, width);
+        y = constrainAxis(y, centerY, contentH, top, height);
+    }
+    private static float constrainAxis(float value, float center, float content, float start, float viewport) {
+        if (content <= viewport || viewport <= 0) return 0;
+        float min = start + viewport - (center + content / 2f);
+        float max = start - (center - content / 2f);
+        return Math.max(min, Math.min(max, value));
+    }
+}
