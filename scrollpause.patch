@@ -0,0 +1,335 @@
+package app.morphe.extension.youtube.patches;
+
+import android.graphics.Rect;
+import android.app.Activity;
+import android.graphics.Color;
+import android.graphics.drawable.GradientDrawable;
+import android.os.Handler;
+import android.os.Looper;
+import android.view.MotionEvent;
+import android.view.ScaleGestureDetector;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewTreeObserver;
+import android.view.ViewConfiguration;
+import android.widget.TextView;
+
+import java.lang.ref.WeakReference;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import java.util.Locale;
+
+import app.morphe.extension.shared.Utils;
+import app.morphe.extension.youtube.settings.Settings;
+import app.morphe.extension.youtube.shared.PlayerType;
+import app.morphe.extension.youtube.shared.ShortsPlayerState;
+import kotlin.Unit;
+
+/** Custom addition, 2026-10-20. See upstream LICENSE and NOTICE. */
+@SuppressWarnings("unused")
+public final class SmoothZoomPatch {
+    private static final SmoothZoomScale zoom = new SmoothZoomScale();
+    private static final SmoothZoomPan pan = new SmoothZoomPan();
+    private static WeakReference<View> playerRef = new WeakReference<>(null);
+    private static final List<ClipState> clips = new ArrayList<>();
+    private static ViewTreeObserver.OnPreDrawListener preDraw;
+    private static WeakReference<View> preDrawHost = new WeakReference<>(null);
+    private static boolean initialized;
+    private static boolean gesture;
+    private static boolean ownsTransform;
+    private static float originalX, originalY, originalPivotX, originalPivotY;
+    private static float originalTranslationX, originalTranslationY;
+    private static String videoId;
+    private static boolean panCandidate, panning;
+    private static float downX, downY, lastX, lastY;
+    private static int panPointer;
+    private static final Handler hudHandler = new Handler(Looper.getMainLooper());
+    private static TextView hud;
+    private static WeakReference<ViewGroup> hudHost = new WeakReference<>(null);
+    private static final Runnable HIDE_HUD = SmoothZoomPatch::hideHud;
+
+    public static boolean isPatchIncluded() { return false; } // Set by patcher.
+
+    public static boolean isEnabled() {
+        return isPatchIncluded() && Settings.SMOOTH_PINCH_ZOOM.get()
+                && !Settings.DISABLE_FULLSCREEN_ZOOM_GESTURE.get();
+    }
+
+    private static boolean fullscreen() {
+        return PlayerType.getCurrent() == PlayerType.WATCH_WHILE_FULLSCREEN
+                && !ShortsPlayerState.isOpen();
+    }
+
+    /** Injection point, also used when handing off from fullscreen stretch/fill. */
+    public static void onPlayerViewLayout(View view) {
+        if (!initialized) {
+            initialized = true;
+            PlayerType.getOnChange().addObserver(type -> {
+                Utils.runOnMainThreadNowOrLater(() -> {
+                    if (!fullscreen()) reset();
+                });
+                return Unit.INSTANCE;
+            });
+        }
+        if (view != null && view != playerRef.get()) {
+            reset();
+            playerRef = new WeakReference<>(view);
+        }
+        apply();
+    }
+
+    public static boolean onScaleBegin(ScaleGestureDetector detector) {
+        View player = playerRef.get();
+        gesture = detector != null && fullscreen() && player != null
+                && player.isAttachedToWindow() && player.getWidth() > 0;
+        if (gesture) showHud();
+        return gesture;
+    }
+
+    public static boolean onScale(ScaleGestureDetector detector) {
+        if (!gesture || detector == null || !fullscreen()) return false;
+        zoom.update(detector.getScaleFactor());
+        apply();
+        showHud();
+        return true;
+    }
+
+    public static void onScaleEnd(ScaleGestureDetector detector) {
+        gesture = false;
+        apply(); // Keep the exact factor; no fit/fill snap on release.
+        if (fullscreen() && isEnabled()) showHud();
+    }
+
+    /** Activity touch hook. Consume actual pan drags; taps and multi-touch reach YouTube. */
+    public static boolean onTouchEvent(Activity activity, MotionEvent event) {
+        if (event == null || !isEnabled() || !fullscreen() || zoom.get() <= 1f) {
+            panCandidate = panning = false;
+            return false;
+        }
+        int action = event.getActionMasked();
+        if (action == MotionEvent.ACTION_DOWN) {
+            panPointer = event.getPointerId(0);
+            downX = lastX = event.getRawX();
+            downY = lastY = event.getRawY();
+            View player = playerRef.get();
+            Rect visible = new Rect();
+            // Leave the bottom controls/seekbar available to the normal player.
+            float margin = 64 * activity.getResources().getDisplayMetrics().density;
+            panCandidate = pan.cropped() && player != null && player.getGlobalVisibleRect(visible)
+                    && visible.contains((int) downX, (int) downY)
+                    && downY < activity.getWindow().getDecorView().getHeight() - margin;
+            panning = false;
+        } else if (action == MotionEvent.ACTION_POINTER_DOWN) {
+            if (panning) {
+                // A pan cancelled the view's original stream. Re-seed it before handing
+                // the new two-finger gesture back to YouTube's ScaleGestureDetector.
+                MotionEvent down = MotionEvent.obtain(event.getDownTime(), event.getEventTime(),
+                        MotionEvent.ACTION_DOWN, event.getX(0), event.getY(0), event.getMetaState());
+                activity.getWindow().superDispatchTouchEvent(down);
+                down.recycle();
+            }
+            panCandidate = panning = false;
+        } else if (action == MotionEvent.ACTION_POINTER_UP) {
+            if (event.getPointerCount() == 2) {
+                int remaining = event.getActionIndex() == 0 ? 1 : 0;
+                panPointer = event.getPointerId(remaining);
+                downX = lastX = rawX(event, remaining);
+                downY = lastY = rawY(event, remaining);
+                panCandidate = pan.cropped();
+                panning = false;
+            }
+        } else if (action == MotionEvent.ACTION_MOVE && event.getPointerCount() == 1 && panCandidate) {
+            int index = event.findPointerIndex(panPointer);
+            if (index < 0) return false;
+            float x = rawX(event, index), y = rawY(event, index);
+            int slop = ViewConfiguration.get(activity).getScaledTouchSlop();
+            if (!panning && Math.hypot(x - downX, y - downY) > slop) {
+                MotionEvent cancel = MotionEvent.obtain(event);
+                cancel.setAction(MotionEvent.ACTION_CANCEL);
+                activity.getWindow().superDispatchTouchEvent(cancel);
+                cancel.recycle();
+                panning = true;
+                AutoPausePatch.onPlayerPan();
+            }
+            if (panning) {
+                pan.drag(x - lastX, y - lastY);
+                lastX = x;
+                lastY = y;
+                apply();
+                showHud();
+                return true;
+            }
+        } else if (action == MotionEvent.ACTION_UP || action == MotionEvent.ACTION_CANCEL) {
+            boolean consumed = panning;
+            panCandidate = panning = false;
+            if (consumed) showHud();
+            return consumed;
+        }
+        return false;
+    }
+
+    private static float rawX(MotionEvent e, int i) { return e.getX(i) + e.getRawX() - e.getX(); }
+    private static float rawY(MotionEvent e, int i) { return e.getY(i) + e.getRawY() - e.getY(); }
+
+    private static void showHud() {
+        Activity activity = Utils.getActivity();
+        if (activity == null || !(activity.getWindow().getDecorView() instanceof ViewGroup root)) return;
+        if (hud == null || hudHost.get() != root) {
+            hideHud();
+            hud = new TextView(activity);
+            float density = activity.getResources().getDisplayMetrics().density;
+            hud.setTextColor(Color.WHITE);
+            hud.setTextSize(16);
+            hud.setPadding((int) (12 * density), (int) (7 * density), (int) (12 * density), (int) (7 * density));
+            GradientDrawable background = new GradientDrawable();
+            background.setColor(0xBB000000);
+            background.setCornerRadius(10 * density);
+            hud.setBackground(background);
+            hud.setClickable(false);
+            hud.setFocusable(false);
+            hud.setImportantForAccessibility(View.IMPORTANT_FOR_ACCESSIBILITY_NO);
+            root.getOverlay().add(hud);
+            hudHost = new WeakReference<>(root);
+        }
+        hud.setText(String.format(Locale.getDefault(), "%.1f× · %.0f%%", zoom.get(), zoom.get() * 100));
+        hud.measure(View.MeasureSpec.makeMeasureSpec(root.getWidth(), View.MeasureSpec.AT_MOST),
+                View.MeasureSpec.makeMeasureSpec(root.getHeight(), View.MeasureSpec.AT_MOST));
+        int x = (root.getWidth() - hud.getMeasuredWidth()) / 2;
+        int y = (int) (40 * activity.getResources().getDisplayMetrics().density);
+        hud.layout(x, y, x + hud.getMeasuredWidth(), y + hud.getMeasuredHeight());
+        hudHandler.removeCallbacks(HIDE_HUD);
+        hudHandler.postDelayed(HIDE_HUD, 900);
+    }
+
+    private static void hideHud() {
+        hudHandler.removeCallbacks(HIDE_HUD);
+        ViewGroup host = hudHost.get();
+        if (hud != null && host != null) host.getOverlay().remove(hud);
+        hud = null;
+        hudHost.clear();
+    }
+
+    public static void onVideoChanged(String id) {
+        Utils.runOnMainThreadNowOrLater(() -> {
+            if (!Objects.equals(videoId, id)) {
+                videoId = id;
+                reset();
+            }
+        });
+    }
+
+    private static void apply() {
+        View player = playerRef.get();
+        if (!isEnabled() || !fullscreen() || player == null || !player.isAttachedToWindow()) {
+            reset();
+            return;
+        }
+        if (zoom.get() == 1f) {
+            restore();
+            return;
+        }
+        if (!ownsTransform) {
+            ownsTransform = true;
+            originalX = player.getScaleX();
+            originalY = player.getScaleY();
+            originalPivotX = player.getPivotX();
+            originalPivotY = player.getPivotY();
+            originalTranslationX = player.getTranslationX();
+            originalTranslationY = player.getTranslationY();
+            for (View current = player; current != null;) {
+                clips.add(new ClipState(current));
+                if (!(current.getParent() instanceof View parent)) break;
+                current = parent;
+            }
+            preDraw = () -> { apply(); return true; };
+            player.getViewTreeObserver().addOnPreDrawListener(preDraw);
+            preDrawHost = new WeakReference<>(player);
+        }
+        for (ClipState state : clips) state.unclip();
+        player.setPivotX(player.getWidth() / 2f);
+        player.setPivotY(player.getHeight() / 2f);
+        // Scale only the player view. Scaling its surface too would square the factor.
+        player.setScaleX(originalX * zoom.get());
+        player.setScaleY(originalY * zoom.get());
+        int[] location = new int[2], viewport = new int[2];
+        player.getLocationOnScreen(location);
+        View root = player.getRootView();
+        root.getLocationOnScreen(viewport);
+        float aspect = FullscreenVideoScalePatch.smoothZoomContentAspect(player);
+        float contentW = Math.min(player.getWidth(), player.getHeight() * aspect);
+        float contentH = Math.min(player.getHeight(), player.getWidth() / aspect);
+        float centerX = location[0] + player.getWidth() * player.getScaleX() / 2f
+                - (player.getTranslationX() - originalTranslationX);
+        float centerY = location[1] + player.getHeight() * player.getScaleY() / 2f
+                - (player.getTranslationY() - originalTranslationY);
+        pan.constrain(centerX, centerY, contentW * player.getScaleX(), contentH * player.getScaleY(),
+                viewport[0], viewport[1], root.getWidth(), root.getHeight());
+        player.setTranslationX(originalTranslationX + pan.x());
+        player.setTranslationY(originalTranslationY + pan.y());
+    }
+
+    private static void reset() {
+        gesture = false;
+        zoom.reset();
+        panCandidate = panning = false;
+        hideHud();
+        restore();
+    }
+
+    private static void restore() {
+        View host = preDrawHost.get();
+        if (preDraw != null && host != null && host.getViewTreeObserver().isAlive()) {
+            host.getViewTreeObserver().removeOnPreDrawListener(preDraw);
+        }
+        preDraw = null;
+        preDrawHost.clear();
+        View player = playerRef.get();
+        if (ownsTransform && player != null) {
+            player.setScaleX(originalX);
+            player.setScaleY(originalY);
+            player.setPivotX(originalPivotX);
+            player.setPivotY(originalPivotY);
+            player.setTranslationX(originalTranslationX);
+            player.setTranslationY(originalTranslationY);
+        }
+        pan.reset();
+        ownsTransform = false;
+        for (ClipState state : clips) state.restore();
+        clips.clear();
+    }
+
+    private static final class ClipState {
+        final WeakReference<View> ref;
+        final Rect bounds;
+        final boolean outline, children, padding;
+        ClipState(View view) {
+            ref = new WeakReference<>(view);
+            Rect clip = view.getClipBounds();
+            bounds = clip == null ? null : new Rect(clip);
+            outline = view.getClipToOutline();
+            children = view instanceof ViewGroup group && group.getClipChildren();
+            padding = view instanceof ViewGroup group && group.getClipToPadding();
+        }
+        void unclip() {
+            View view = ref.get();
+            if (view == null) return;
+            view.setClipBounds(null);
+            view.setClipToOutline(false);
+            if (view instanceof ViewGroup group) {
+                group.setClipChildren(false);
+                group.setClipToPadding(false);
+            }
+        }
+        void restore() {
+            View view = ref.get();
+            if (view == null) return;
+            view.setClipBounds(bounds);
+            view.setClipToOutline(outline);
+            if (view instanceof ViewGroup group) {
+                group.setClipChildren(children);
+                group.setClipToPadding(padding);
+            }
+        }
+    }
+}
diff --git a/extensions/youtube/src/main/java/app/morphe/extension/youtube/patches/SmoothZoomScale.java b/extensions/youtube/src/main/java/app/morphe/extension/youtube/patches/SmoothZoomScale.java
new file mode 100644
