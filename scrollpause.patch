@@ -0,0 +1,17 @@
+package app.morphe.extension.youtube.patches;
+
+/** Continuous zoom relative to fit, independent of the display/video aspect ratios. */
+final class SmoothZoomScale {
+    private float scale = 1f;
+
+    float get() { return scale; }
+
+    float update(float factor) {
+        if (Float.isFinite(factor) && factor > 0f) {
+            scale = Math.max(1f, Math.min(8f, scale * factor));
+        }
+        return scale;
+    }
+
+    void reset() { scale = 1f; }
+}
